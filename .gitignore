/target
**/*.rs.bk
*.pdb

# Local config and secrets. A committed franking key would invalidate every report
# it ever signed, so keep these out by default.
/.env
*.local.toml
/data

# Tauri build output
clients/desktop/src-tauri/target/
clients/desktop/src-tauri/gen/

# Playwright, installed by the CI desktop job for the browser call test.
node_modules/

# Agent worktrees: full checkouts with their own .git, never part of this tree.
.claude/worktrees/
